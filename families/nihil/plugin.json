  "switch": {
    "name": "Switch to NiHiL Panel Family",
    "description": "Use the minimal NiHiL shell layout",
    "icon": "visibility",
    "keywords": [
      "family",
      "panel",
      "nihil",
      "minimal",
      "lightweight",
      "layout"
    ]
  },
