      "nihil.appearance.numbersFontFamily",
      "nihil.appearance.titleFontFamily",
      "nihil.appearance.followTheme",
      "nihil.appearance.theme.surface"
    ]
  },
  "devDestinations": [
    {
      "id": "nihil/palette",
      "surface": "iris-palette",
      "settleMs": 300
    },
    {
      "id": "nihil/controls",
      "surface": "iris-controls",
      "settleMs": 300
    },
    {
      "id": "nihil/session",
      "surface": "iris-session",
      "settleMs": 300
    }
