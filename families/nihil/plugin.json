  "widgetDesign": {
    "key": "nihil.design",
    "shared": "nihil.widgets.design",
    "prefix": "nihil",
    "face": "nihil",
    "faceLabel": "NiHiL",
    "plain": "material",
    "choices": [
      "nihil",
      "prism",
      "material",
      "instrument",
      "readout"
    ],
    "faces": [
      {
        "value": "prism",
        "label": "Prism",
        "glyph": "flare",
        "part": "widgetPrism",
        "ignores": [
          "showBorder",
          "borderOpacity",
          "borderWidth",
          "showWeather"
        ]
      }
    ]
  },
  "flags": {
    "lockSurfaceSync": true,
    "lazyServices": true,
    "verbs": true,
    "mediaFeedback": true,
    "appsPalette": true,
    "liveJobs": true,
    "cameraWatch": true,
    "quietScrollbars": true,
    "sharedDesktop": true,
    "widgetSearch": true,
    "printedWallpaper": true
  },
  "customWidget": {
    "face": "widgets/templates/IrisCompact.qml",
    "slots": [
      "island.desktop"
    ]
  },
  "configKey": "nihil",
  "enabledPanels": [
    "irisBar",
    "irisBackground",
    "irisPalette",
    "irisControlCenter",
    "irisNotificationPopup",
    "irisOnScreenDisplay",
    "irisSessionScreen",
    "irisLock",
    "irisPolkit"
  ],
  "settings": {
    "edgeMusic": {
      "key": "nihil.surround.music",
      "when": "nihil.surround.enable",
      "fallback": "widget"
    },
    "font": {
      "key": "nihil.appearance.fontFamily",
      "fallback": "Archivo"
    },
    "scheme": {
      "key": "nihil.appearance.scheme",
      "fallback": "auto"
    },
    "appsSurface": {
      "key": "nihil.appearance.materialForApps",
      "fallback": true
    },
    "bannerDuration": {
      "key": "nihil.notifications.duration",
      "fallback": 4000
    },
    "barAutoHide": {
      "key": "nihil.bar.autoHide",
      "fallback": false
    },
    "dockEnabled": {
      "key": "nihil.dock.enable",
      "fallback": true
    }
  },
  "loginScreen": {
    "look": "nihil",
    "styles": [
      "cover",
      "frame",
      "lens"
    ],
    "reads": [
      "nihil.lock.scene",
      "nihil.lock.type",
      "nihil.lock.blocks.session",
