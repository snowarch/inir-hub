pragma ComponentBehavior: Bound

import QtQuick
import qs.services

// The rows Material draws for the compositor in use: each names a function of the base's vocabulary (`comp`, `key`),
// never a compositor's file or option. What the running one cannot do is filtered out by `shown`.
QtObject {
    id: data

    function layoutMode(): string {
        return CompositorConfig.has("layout", "mode") ? String(CompositorConfig.value({ comp: "layout", key: "mode", fallback: "scrolling" })) : "scrolling"
    }
    function cornersUsed(): bool {
        return ["top-left", "top-right", "bottom-left", "bottom-right"].some(corner => String(CompositorConfig.value({ comp: "corners", key: corner, fallback: "" })).length > 0)
    }
    function shown(row: var): bool {
        CompositorConfig.revision
        return CompositorConfig.has(row.comp, row.key) && (!row.when || row.when() === true)
    }
    function of(group: string): var {
        CompositorConfig.revision
        return data.rows.filter(row => row.group === group && data.shown(row))
    }

