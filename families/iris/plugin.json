{
  "id": "iris",
  "kind": "family",
  "name": "iRiS",
  "summary": "One living body: the Island, the chassis and Apple-grade motion.",
  "tagline": "Island, pieces and a Dock on any edge.",
  "icon": "visibility",
  "version": "2.33.27",
  "provides": "modules/iris",
  "parts": {
    "critical": "critical/ShellIrisCriticalPanels.qml",
    "panels": "ShellIrisPanelsImpl.qml",
    "closeConfirm": "closeConfirm/IrisCloseConfirmContent.qml",
    "editStage": "edit/IrisEditStage.qml",
    "lockSurface": "lock/IrisLockSurface.qml",
    "widgetFace.agenda": "widgets/IrisAgendaFace.qml",
    "widgetFace.battery": "widgets/IrisBatteryFace.qml",
    "widgetFace.calendar": "widgets/IrisCalendarFace.qml",
    "widgetFace.clock": "widgets/IrisClockFace.qml",
    "widgetFace.controls": "widgets/IrisControlsFace.qml",
    "widgetFace.date": "widgets/IrisDateFace.qml",
    "widgetFace.day": "widgets/IrisDayFace.qml",
    "widgetFace.news": "widgets/IrisNewsFace.qml",
    "widgetFace.notes": "widgets/IrisNotesFace.qml",
    "widgetFace.nowPlaying": "widgets/IrisNowPlayingFace.qml",
    "widgetFace.profile": "widgets/IrisProfileFace.qml",
    "widgetFace.screenTime": "widgets/IrisScreenTimeFace.qml",
    "widgetFace.palette": "widgets/IrisPaletteFace.qml",
    "widgetFace.lyrics": "widgets/IrisLyricsFace.qml",
    "widgetFace.timer": "widgets/IrisTimerFace.qml",
    "widgetFace.todo": "widgets/IrisTodoFace.qml",
    "widgetFace.uptime": "widgets/IrisUptimeFace.qml",
    "widgetFace.vitals": "widgets/IrisVitalsFace.qml",
    "widgetFace.photo": "widgets/IrisPhotoFace.qml",
    "widgetFace.weather": "widgets/IrisWeatherFace.qml",
    "widgetFace.worldClock": "widgets/IrisWorldClockFace.qml",
    "widgetOutfit": "edit/IrisWidgetOutfit.qml",
    "style": "IrisFamilyStyle.qml",
    "control.switch": "components/IrisSwitch.qml",
    "control.scrubber": "components/IrisScrubber.qml",
    "control.segmented": "components/IrisSegmented.qml",
    "cutPlate": "components/IrisCutPlate.qml",
    "widget.sizeGrip": "widgets/IrisSizeGrip.qml",
    "widgetLook": "widgets/IrisWidgetLook.qml",
    "widgetPlate": "widgets/IrisWidgetPlate.qml",
    "designFace": "widgets/IrisDesignFace.qml",
    "mediaCard": "components/IrisMediaCard.qml",
    "artwork": "components/IrisArtwork.qml",
    "clock": "components/IrisClock.qml",
    "card": "stage/IrisCardContent.qml",
    "desktopMenu": "background/IrisDesktopMenuPart.qml",
    "wallpaper.afterglow": "background/IrisAfterglowWallpaper.qml",
    "wallpaper.leak": "background/IrisLeakWallpaper.qml",
    "regionToolbar": "regionSelector/IrisOptionsToolbar.qml",
    "familyTransition": "IrisFamilyTransition.qml",
    "config": "IrisConfigSchema.qml",
    "layout": "IrisLayout.qml",
    "welcome": "welcome/IrisWelcome.qml"
  },
  "widgetDesign": {
    "key": "iris.design",
    "shared": "iris.widgets.design",
    "prefix": "iris",
    "face": "iris",
    "faceLabel": "iRiS",
    "plain": "material",
    "choices": ["iris", "material", "instrument", "readout"]
  },
  "flags": {
    "lockSurfaceSync": true,
    "lazyServices": true,
    "verbs": true,
    "mediaFeedback": true,
    "appsPalette": true,
    "liveJobs": true,
    "cameraWatch": true,
    "quietScrollbars": true,
    "sharedDesktop": true,
    "widgetSearch": true
  },
  "customWidget": {
    "face": "widgets/templates/IrisCompact.qml",
    "slots": [
      "island.desktop"
    ]
  },
  "configKey": "iris",
  "enabledPanels": [
    "irisBar",
    "irisBackground",
    "irisPalette",
    "irisControlCenter",
    "irisNotificationPopup",
    "irisOnScreenDisplay",
    "irisSessionScreen",
    "irisLock",
    "irisPolkit"
  ],
  "settings": {
    "edgeMusic": {
      "key": "iris.surround.music",
      "when": "iris.surround.enable",
      "fallback": "widget"
    },
    "font": {
      "key": "iris.appearance.fontFamily",
      "fallback": "Geist"
    },
    "scheme": {
      "key": "iris.appearance.scheme",
      "fallback": "auto"
    },
    "appsSurface": {
      "key": "iris.appearance.materialForApps",
      "fallback": true
    },
    "bannerDuration": {
      "key": "iris.notifications.duration",
      "fallback": 4000
    },
    "barAutoHide": {
      "key": "iris.bar.autoHide",
      "fallback": false
    },
    "dockEnabled": {
      "key": "iris.dock.enable",
      "fallback": true
    }
  },
  "loginScreen": {
    "look": "iris",
    "reads": [
      "iris.lock.scene",
      "iris.lock.type",
      "iris.lock.blocks.session",
      "iris.appearance.fontFamily",
      "iris.appearance.numbersFontFamily",
      "iris.appearance.titleFontFamily",
      "iris.appearance.followTheme",
      "iris.appearance.theme.surface"
    ]
  },
  "devDestinations": [
    {
      "id": "iris/palette",
      "surface": "iris-palette",
      "settleMs": 300
    },
    {
      "id": "iris/controls",
      "surface": "iris-controls",
      "settleMs": 300
    },
    {
      "id": "iris/session",
      "surface": "iris-session",
      "settleMs": 300
    }
  ],
  "switch": {
    "name": "Switch to iRiS Panel Family",
    "description": "Use the minimal iRiS shell layout",
    "icon": "visibility",
    "keywords": [
      "family",
      "panel",
      "iris",
      "minimal",
      "lightweight",
      "layout"
    ]
  },
  "widgetOptions": {
    "clock": [
      {"key":"iris.face","label":"Face","type":"choice","default":"analog","when":"face","choices":[["analog","Analog","schedule"],["digital","Digital","timer_10"],["hour","Hour","wb_twilight"]]},
      {"key":"iris.seconds","label":"Second hand","type":"switch","default":true,"when":["face",{"iris.face":"analog"}]},
      {"key":"iris.week","label":"Week strip","type":"switch","default":true,"when":["face",{"iris.face":["analog","digital"]},{"not":{"sizeClass":"small"}}]}
    ],
    "mediaControls": [
      {"key":"iris.lyrics","label":"Synced lyrics","type":"switch","default":true,"when":"face"},
      {"key":"iris.rest","label":"Rest when paused","type":"switch","default":true,"when":"face"}
    ],
    "monthCalendar": [
      {"key":"iris.face","label":"Face","type":"choice","default":"month","when":"face","choices":[["month","Month","calendar_view_month"],["week","Week","view_week"]]}
    ],
    "screenTime": [
      {"key":"iris.face","label":"Face","type":"choice","default":"curve","when":"face","choices":[["curve","Curve","monitoring"],["ribbon","Ribbon","view_column"]]}
    ],
    "systemMonitor": [
      {"key":"iris.face","label":"Face","type":"choice","default":"trend","when":"face","choices":[["trend","Trend","show_chart"],["bars","Bars","bar_chart"]]},
      {"key":"iris.lead","label":"Main","type":"choice","default":"auto","when":"face","choices":[["auto","Auto"],["cpu","Processor","memory"],["mem","Memory","memory_alt"],["gpu","Graphics","developer_board"],["temp","CPU heat","thermostat"],["gpuTemp","GPU heat","thermostat"]],"keywords":["lead","main","first","big"]}
    ],
    "controls": [
      {"key":"iris.tile.wifi","label":"Wi-Fi","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.tile.bluetooth","label":"Bluetooth","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.tile.focus","label":"Focus","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.tile.nightLight","label":"Night light","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.tile.awake","label":"Keep awake","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.tile.gameMode","label":"Game mode","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.tile.mic","label":"Microphone","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.tile.darkMode","label":"Dark mode","type":"switch","default":true,"tune":false,"keywords":["keys","tiles","toggle"]},
      {"key":"iris.sliders","label":"Volume and brightness","type":"switch","default":true,"when":{"not":{"sizeClass":"small"}},"tune":false}
    ],
    "palette": [
      {"key":"iris.source","label":"Colours from","type":"choice","default":"wallpaper","choices":[["wallpaper","Wallpaper"],["music","Music"],["random","Random"]]}
    ],
    "weather": [
      {"key":"iris.details","label":"Details","type":"switch","default":true,"when":["face",{"sizeClass":"large"}],"keywords":["humidity","wind","uv","air"]}
    ],
    "*": [
      {"key":"iris.material","label":"Material","type":"choice","default":"auto","page":"look","tune":true,"when":["face",{"showBackground":true}],"choices":[["auto","Same as every widget"],["glass","Glass"],["solid","Solid"],["tinted","Tinted"]],"keywords":["glass","transparent","background","plate","fondo","vidrio"]}
    ]
  }
}
