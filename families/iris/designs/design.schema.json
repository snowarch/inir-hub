{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://inir.space/hub/schema/iris-design.schema.json",
    "title": "An iRiS Design",
    "description": "design.json: the values an iRiS Design wears over iRiS's one set of components. A value left out is iRiS's own (designs/iris/design.json); a value set here is the Design's, and Settings hides the row it decides. Read by the shell, `inir hub check` and the devkit, with the same rules.",
    "type": "object",
    "additionalProperties": false,
    "required": ["tokens"],
    "properties": {
        "$schema": { "type": "string" },
        "tokens": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "colour": {
                    "description": "Where colour comes from. Roles are fixed meaning colours per scheme; text keeps 7:1 on surface, secondary text 4.5:1, an accent fill's ink 4.5:1.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "language": { "description": "The solver's language (inir-accel's washi): iris, washi, airisu or material:<variant>; empty keeps the person's.", "type": "string", "pattern": "^(|iris|washi|airisu|material:[a-zA-Z]+)$" },
                        "accent": { "description": "The accent it always wears: \"design\" is its language's own pigment (a language with a wheel: airisu); empty keeps the person's accent, solved in its language.", "type": "string", "enum": ["", "design"] },
                        "highlight": { "description": "The highlight it always wears: \"design\" is its language's own pigment (a language with a wheel: airisu); empty keeps the person's highlight, solved in its language.", "type": "string", "enum": ["", "design"] },
                        "preset": { "description": "The ink ladder: how strong fills and text steps read.", "type": "string", "enum": ["", "iris", "soft", "crisp", "round", "angular", "contrast", "night"] },
                        "schemes": { "description": "The schemes it draws, first one preferred; a scheme it leaves out shows its first.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["dark", "ink", "light"] } },
                        "roles": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "dark": { "$ref": "#/$defs/roles" },
                                "ink": { "$ref": "#/$defs/roles" },
                                "light": { "$ref": "#/$defs/roles" }
                            }
                        }
                    }
                },
                "type": {
                    "description": "Faces by role. A face the Design brings ships in its folder (OFL), listed in files.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "text": { "$ref": "#/$defs/face" },
                        "title": { "$ref": "#/$defs/face" },
                        "numbers": { "$ref": "#/$defs/face" },
                        "dot": { "$ref": "#/$defs/face" },
                        "mono": { "$ref": "#/$defs/face" },
                        "figureLean": { "description": "How far figures lean forward, as a shear.", "type": "number", "minimum": -0.3, "maximum": 0.3 },
                        "figureWeight": { "type": "string", "enum": ["", "light", "regular", "bold"] },
                        "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.(ttf|otf)$" } }
                    }
                },
                "shape": {
                    "description": "The one ladder of forms every surface asks by role, before density and the person's shape tweak.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "ladder": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "panel": { "$ref": "#/$defs/rung" },
                                "sheet": { "$ref": "#/$defs/rung" },
                                "plate": { "$ref": "#/$defs/rung" },
                                "card": { "$ref": "#/$defs/rung" },
                                "tile": { "$ref": "#/$defs/rung" },
                                "row": { "$ref": "#/$defs/rung" },
                                "chip": { "$ref": "#/$defs/rung" },
                                "micro": { "$ref": "#/$defs/rung" }
                            }
                        },
                        "piece": { "description": "Bubbles and pieces: circle, squircle or square; empty keeps the person's.", "type": "string", "enum": ["", "circle", "squircle", "square"] },
                        "tile": { "description": "A small piece's corner (a cover, a workspace tile) as a share of its side.", "type": "number", "minimum": 0, "maximum": 0.5 }
                    }
                },
                "material": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "glass": { "description": "refuse: every body is opaque and Settings says the Design is made that way.", "type": "string", "enum": ["allow", "refuse"] },
                        "texture": { "type": "string", "enum": ["", "solid", "aurora", "angel", "regalia", "flat", "streak", "afterglow", "leak"] },
                        "edge": { "type": "string", "enum": ["", "light", "line", "none"] },
                        "edgeWidth": { "description": "In device pixels; 0 keeps the person's.", "type": "integer", "minimum": 0, "maximum": 3 },
                        "shadow": { "description": "How much of its shadow a body casts: 0 none, 1 iRiS's.", "type": "number", "minimum": 0, "maximum": 2 },
                        "plates": {
                            "description": "The black and the white an icon plate can wear: [top, base].",
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "black": { "$ref": "#/$defs/pair" },
                                "white": { "$ref": "#/$defs/pair" }
                            }
                        }
                    }
                },
                "motion": {
                    "description": "How shapes grow. Bouncing and elastic styles are not offered to a Design.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "morph": { "type": "string", "enum": ["", "direct", "glide", "snap", "instant", "tuned"] },
                        "duration": { "description": "Milliseconds a shape takes to grow; 0 keeps the person's.", "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 0 }, { "type": "integer", "minimum": 100, "maximum": 400 }] }
                    }
                },
                "look": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "look": { "description": "The dialect it speaks; empty keeps the person's.", "type": "string", "enum": ["", "apple", "nothing", "synth", "gel"] },
                        "traits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "marks": { "type": "string", "enum": ["tile", "glyph", "key", "gloss"] },
                                "selection": { "type": "string", "enum": ["wash", "plate"] },
                                "captions": { "type": "string", "enum": ["plain", "mono"] },
                                "titles": { "type": "string", "enum": ["plain", "lower"] },
                                "plate": { "type": "string", "enum": ["flat", "line", "key", "gloss"] },
                                "hover": { "type": "string", "enum": ["wash", "plate"] },
                                "index": { "type": "boolean" },
                                "sections": { "type": "string", "enum": ["plain", "line"] },
                                "rings": { "type": "string", "enum": ["none", "edge"] },
                                "pages": { "type": "string", "enum": ["drop", "hang"] }
                            }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/hex" } },
        "face": { "type": "string", "maxLength": 64 },
        "rung": { "type": "integer", "minimum": 0, "maximum": 48 },
        "roles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "surface": { "$ref": "#/$defs/hex" },
                "surfaceHigh": { "$ref": "#/$defs/hex" },
                "surfaceHighest": { "$ref": "#/$defs/hex" },
                "text": { "$ref": "#/$defs/hex" },
                "textSecondary": { "$ref": "#/$defs/hex" },
                "textTertiary": { "$ref": "#/$defs/hex" },
                "accent": { "$ref": "#/$defs/hex" },
                "onAccent": { "$ref": "#/$defs/hex" },
                "accentFill": { "$ref": "#/$defs/hex" },
                "onAccentFill": { "$ref": "#/$defs/hex" },
                "highlight": { "$ref": "#/$defs/hex" },
                "success": { "$ref": "#/$defs/hex" },
                "warning": { "$ref": "#/$defs/hex" },
                "danger": { "$ref": "#/$defs/hex" },
                "dangerFill": { "$ref": "#/$defs/hex" },
                "onDangerFill": { "$ref": "#/$defs/hex" }
            }
        }
    }
}
