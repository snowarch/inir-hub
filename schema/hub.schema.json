{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://snowarch.github.io/inir-hub/schema/hub.schema.json",
    "title": "iNiR Hub listing",
    "description": "hub.json: how an item appears in the Hub. The item's own file (widget.json, theme.json, manifest.json) is what iNiR reads.",
    "type": "object",
    "required": [
        "version",
        "summary",
        "authors",
        "license"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "x.y.z; raise it with every change"
        },
        "changes": {
            "type": "object",
            "description": "What people notice in each version, newest kept: {\"1.1.0\": [\"Clock face follows the wallpaper\"]}. Every version raise adds its line.",
            "propertyNames": {
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                }
            }
        },
        "summary": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80,
            "description": "One line for the card"
        },
        "description": {
            "type": "string",
            "maxLength": 600
        },
        "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
            },
            "description": "GitHub handles"
        },
        "license": {
            "type": "string",
            "minLength": 2,
            "description": "SPDX id, e.g. MIT"
        },
        "tags": {
            "type": "array",
            "maxItems": 6,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]{2,20}$"
            }
        },
        "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": [
                    "process",
                    "network",
                    "files",
                    "inject"
                ]
            }
        },
        "hosts": {
            "type": "array",
            "uniqueItems": true,
            "description": "Every internet host the code reaches (a domain covers its subdomains); shown to people before they install",
            "items": {
                "type": "string",
                "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
            }
        },
        "minInir": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Oldest iNiR it works on"
        },
        "provides": {
            "type": "string",
            "pattern": "^modules/[a-z0-9][a-z0-9-]{0,46}[a-z0-9]$",
            "description": "Families, components and Designs: where the plugin lands in the shell, always modules/<its id>"
        },
        "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,46}[a-z0-9]$"
            },
            "description": "Ids of the plugins it needs installed (a Design names the family it dresses)"
        },
        "preview": {
            "type": "string",
            "pattern": "\\.(webp|png|jpe?g)$",
            "description": "Screenshot in the item folder, 1280x800 (CONTRIBUTING.md, Previews)"
        }
    }
}
