{
  "name": "iNiR Docker",
  "icon": "deployed_code",
  "version": "0.6.0",
  "author": "yukazakiri",
  "description": "Docker containers on your desktop in three layouts, with live CPU/memory monitoring, lifecycle controls, logs and RAM/CPU limit sliders.",
  "category": "system",
  "main": "Docker.qml",
  "iris": {
    "main": "IrisDocker.qml",
    "slots": [
      "island.desktop"
    ]
  },
  "defaultConfig": {
    "placementStrategy": "free",
    "widgetScale": 100,
    "widgetOpacity": 100,
    "colorMode": "auto",
    "dim": 0,
    "showBackground": true,
    "backgroundOpacity": 0.16,
    "borderWidth": 1,
    "borderOpacity": 0.2,
    "cornerRadius": -1,
    "useBlur": false,
    "x": 320,
    "y": 200,
    "refreshSeconds": 3,
    "maxContainers": 6,
    "showStopped": true,
    "filter": "",
    "showSummary": true,
    "showSparkline": true,
    "layout": "dashboard",
    "showLimits": true
  },
  "configKeys": {
    "layout": {
      "type": "string",
      "default": "dashboard",
      "label": "Layout",
      "options": [
        {
          "label": "Dashboard",
          "value": "dashboard",
          "glyph": "dashboard"
        },
        {
          "label": "Compact",
          "value": "compact",
          "glyph": "view_agenda"
        },
        {
          "label": "Tiles",
          "value": "tiles",
          "glyph": "grid_view"
        }
      ],
      "description": "Dashboard, compact list or visual tiles."
    },
    "filter": {
      "type": "string",
      "default": "",
      "label": "Filter",
      "placeholder": "name, image, state or Compose project",
      "description": "Only show containers that match this text. Docker is not changed."
    },
    "refreshSeconds": {
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 60,
      "step": 1,
      "label": "Refresh every (seconds)"
    },
    "maxContainers": {
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Containers shown"
    },
    "showStopped": {
      "type": "bool",
      "default": true,
      "label": "Show stopped containers"
    },
    "showSummary": {
      "type": "bool",
      "default": true,
      "label": "Show monitoring summary"
    },
    "showSparkline": {
      "type": "bool",
      "default": true,
      "label": "Show CPU history"
    },
    "showLimits": {
      "type": "bool",
      "default": true,
      "label": "Show RAM and CPU limits"
    }
  },
  "resizableAxes": {
    "uniform": "widgetScale"
  },
  "defaultSize": {
    "width": 440,
    "height": 380
  }
}
