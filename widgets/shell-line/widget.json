{
    "name": "Shell Line",
    "icon": "terminal",
    "version": "1.0.0",
    "author": "snowarch",
    "description": "Any command, kept fresh on the desktop or on the iRiS Island. What it prints picks the look: a percentage gets a bar, a number gets a large figure, text gets lines. It only runs while it is on screen, and an error shows what the command said.",
    "category": "system",
    "main": "ShellLine.qml",
    "iris": {
        "main": "IrisShellLine.qml",
        "slots": [
            "island.desktop"
        ]
    },
    "defaultConfig": {
        "placementStrategy": "free",
        "widgetScale": 100,
        "widgetOpacity": 100,
        "colorMode": "auto",
        "dim": 0,
        "showBackground": true,
        "backgroundOpacity": 0.16,
        "borderWidth": 1,
        "borderOpacity": 0.2,
        "cornerRadius": -1,
        "useBlur": false,
        "x": 260,
        "y": 420,
        "style": "shape",
        "shape": "Cookie4Sided"
    },
    "configKeys": {
        "label": {
            "type": "string",
            "default": "Home folder",
            "label": "Label"
        },
        "icon": {
            "type": "string",
            "default": "hard_drive",
            "label": "Icon (a Material Symbols name)"
        },
        "command": {
            "type": "string",
            "default": "echo \"$(df --output=pcent \"$HOME\" | tail -1) used\"",
            "label": "Command (runs with sh -c)"
        },
        "interval": {
            "type": "int",
            "default": 300,
            "min": 5,
            "max": 3600,
            "step": 5,
            "label": "Refresh every (seconds)"
        },
        "lines": {
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 6,
            "step": 1,
            "label": "Lines of text to show"
        }
    },
    "resizableAxes": {
        "uniform": "widgetScale"
    },
    "defaultSize": {
        "width": 306,
        "height": 96
    }
}
