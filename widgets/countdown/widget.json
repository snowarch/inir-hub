{
    "name": "Countdown",
    "icon": "hourglass_bottom",
    "version": "1.2.0",
    "author": "snowarch",
    "description": "Days left until a date you care about. On the desktop in three sizes: the figure in a Material shape you pick with a wavy bar for the wait, or under iRiS its iRiS and Prism cards with the wait as a ruler whose tick for today is lit. Also a card in Material's sidebars, a line on the iRiS Island and a card in Waffle's Widgets panel.",
    "category": "time",
    "main": "Countdown.qml",
    "iris": {
        "main": "IrisCountdown.qml",
        "slots": [
            "island.desktop"
        ],
        "desktop": {
            "iris": "IrisCountdownCard.qml",
            "prism": "PrismCountdown.qml"
        }
    },
    "waffle": {
        "main": "WaffleCountdown.qml"
    },
    "ii": {
        "main": "SidebarCountdown.qml",
        "slots": [
            "sidebar.left",
            "sidebar.right"
        ]
    },
    "sizes": [
        "medium",
        "small",
        "large"
    ],
    "defaultConfig": {
        "placementStrategy": "free",
        "widgetScale": 100,
        "widgetOpacity": 100,
        "colorMode": "auto",
        "dim": 0,
        "showBackground": true,
        "backgroundOpacity": 0.16,
        "borderWidth": 1,
        "borderOpacity": 0.2,
        "cornerRadius": -1,
        "useBlur": false,
        "x": 240,
        "y": 240,
        "style": "shape",
        "shape": "Cookie9Sided",
        "showProgress": true
    },
    "configKeys": {
        "label": {
            "type": "string",
            "default": "New year",
            "label": "What it counts down to"
        },
        "date": {
            "type": "string",
            "default": "2027-01-01",
            "label": "Date: YYYY-MM-DD, or YYYY-MM-DDTHH:MM"
        }
    }
}
