#!/usr/bin/env bash
# Pulls RTSP cameras into fresh JPEG frames for the camera panel.
#
#   inircam-feeds sync <shell-pid> [main-ids]   start the pullers, given the shell's pid
#   inircam-feeds stop                          stop them
#
# Every camera gets its substream. The main stream is pulled only for the cameras named in
# `main-ids` (comma separated) — the one shown large, and any pinned to the desktop — because an
# NVR runs out of sessions long before a grid of ten cameras does.
#
# Frames and pid files live in $XDG_RUNTIME_DIR/inircam, which only its owner
# can read. A camera's URL carries its password, so it is written to a 0600
# list file and ffmpeg reads it from there: ps and /proc show the list's path,
# never the credentials.
set -euo pipefail
umask 077

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/inir/plugins/inircam.json"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
FRAMEDIR="$RUNTIME/inircam"
PIDDIR="$FRAMEDIR/feeds"

mkdir -p "$FRAMEDIR" "$PIDDIR"
chmod 700 "$FRAMEDIR" "$PIDDIR"

log() { printf '%s %s\n' "$(date -Is)" "$*" >&2; }

# A pid file holds "<ffmpeg pid> <shell pid>".
read_pid() { awk '{print $1}' "$1" 2>/dev/null || true; }
read_owner() { awk '{print $2}' "$1" 2>/dev/null || true; }

kill_feed() {
  local pidfile="$1" base
  base=$(basename "$pidfile" .pid)
  if [[ -f "$pidfile" ]]; then
    local pid
    pid=$(read_pid "$pidfile")
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      sleep 0.2
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
  fi
  rm -f "$PIDDIR/${base}.m3u" "$PIDDIR/${base}.log" 2>/dev/null || true
}

start_feed() {
  local cam_id="$1" quality="$2" url="$3"
  local frame="$FRAMEDIR/feed-${QS_PID}-${cam_id}-${quality}.jpg"
  local pidfile="$PIDDIR/${cam_id}-${quality}.pid"
  local logfile="$PIDDIR/${cam_id}-${quality}.log"
  local listfile="$PIDDIR/${cam_id}-${quality}.m3u"

  # if already running and healthy, skip
  if [[ -f "$pidfile" ]]; then
    local pid
    pid=$(read_pid "$pidfile")
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi

  # Hand the URL over in a 0600 list: ffmpeg's command line names the list, not
  # the camera, so the password is not in ps or /proc/*/cmdline for anyone.
  printf "file '%s'\noption rtsp_transport tcp\noption timeout 30000000\n" "${url//\'/%27}" > "$listfile"

  ffmpeg -hide_banner -loglevel warning -nostdin \
    -f concat -safe 0 \
    -protocol_whitelist file,rtsp,rtsps,tcp,udp,rtp,tls,crypto,https,http,data \
    -i "$listfile" -an \
    -vf "fps=8,scale='min(1280,iw)':-2" \
    -q:v 4 -f image2 -update 1 -atomic_writing 1 -y "$frame" \
    </dev/null >>"$logfile" 2>&1 &
  # The owner comes second: a puller started by an earlier shell writes frames under that shell's
  # pid, which the current one would never look at.
  echo "$! $QS_PID" > "$pidfile"
}

build_rtsp_url() {
  local url="$1" user="$2" pass="$3"
  # if credentials already present, return as-is
  if [[ "$url" =~ ^rtsps?://[^/@]+@ ]]; then
    printf '%s' "$url"
    return
  fi
  # inject credentials
  python3 - "$url" "$user" "$pass" <<'PY'
import sys, urllib.parse
url, user, pw = sys.argv[1], sys.argv[2], sys.argv[3]
if not user and not pw:
    print(url)
    sys.exit(0)
m = urllib.parse.urlsplit(url)
auth = urllib.parse.quote(user, safe='')
if pw:
    auth += ':' + urllib.parse.quote(pw, safe='')
print(urllib.parse.urlunsplit((m.scheme, auth + '@' + m.netloc, m.path, m.query, m.fragment)))
PY
}

sync_feeds() {
  [[ -f "$CONFIG" ]] || return 0
  if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "inircam needs ffmpeg to show RTSP cameras; install the ffmpeg package" >&2
    return 1
  fi
  local -a want_ids=()
  local -a want_quals=()
  # parse cameras from config
  while IFS=$'\t' read -r id enabled host user pass urlMain urlSub; do
    [[ "$enabled" == "true" ]] || continue
    # substream for grid
    if [[ -n "$urlSub" && "$urlSub" == rtsp* ]]; then
      local u
      u=$(build_rtsp_url "$urlSub" "$user" "$pass")
      want_ids+=("$id"); want_quals+=("sub")
      start_feed "$id" "sub" "$u"
    fi
    # main stream only for a camera shown large or pinned: the rest would be wasted sessions
    if [[ -n "$urlMain" && "$urlMain" == rtsp* && ",$MAIN_IDS," == *",$id,"* ]]; then
      local u
      u=$(build_rtsp_url "$urlMain" "$user" "$pass")
      want_ids+=("$id"); want_quals+=("main")
      start_feed "$id" "main" "$u"
    fi
  done < <(python3 - "$CONFIG" <<'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
for c in cfg.get('cameras', []):
    def s(v): return (v or '').replace('\t',' ').replace('\n',' ')
    print('\t'.join([
        s(c.get('id')), 'true' if c.get('enabled', True) else 'false',
        s(c.get('host')), s(c.get('username')), s(c.get('password')),
        s(c.get('urlMain') or c.get('url') or ''), s(c.get('urlSub') or '')
    ]))
PY
  )

  # kill feeds not wanted, and frames left by another shell pid
  shopt -s nullglob
  local pf base i keep
  for pf in "$PIDDIR"/*.pid; do
    base=$(basename "$pf" .pid)
    # A puller left by another shell writes frames the current one cannot see: restart it.
    if [[ "$(read_owner "$pf")" != "$QS_PID" ]]; then
      kill_feed "$pf"
      continue
    fi
    keep=0
    for i in "${!want_ids[@]}"; do
      if [[ "$base" == "${want_ids[$i]}-${want_quals[$i]}" ]]; then keep=1; break; fi
    done
    if [[ $keep -eq 0 ]]; then
      kill_feed "$pf"
    fi
  done
  local frame
  for frame in "$FRAMEDIR"/feed-*.jpg; do
    [[ "$(basename "$frame")" == "feed-${QS_PID}-"* ]] || rm -f "$frame"
  done
}

stop_all() {
  local pf
  shopt -s nullglob
  for pf in "$PIDDIR"/*.pid; do kill_feed "$pf"; done
  rm -f "$PIDDIR"/*.m3u "$PIDDIR"/*.log 2>/dev/null || true
}

case "${1:-sync}" in
  sync)
    QS_PID="${2:-}"
    MAIN_IDS="${3:-}"
    if [[ -z "$QS_PID" ]]; then
      echo "usage: $0 sync <shell-pid> [main-camera-ids]" >&2
      exit 2
    fi
    sync_feeds
    ;;
  stop)
    stop_all
    ;;
  *)
    echo "usage: $0 {sync <shell-pid> [main-camera-ids]|stop}" >&2
    exit 1
    ;;
esac
